<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>defaults-dump</string>
  <key>Disabled</key>
  <false/>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>
      export LANG=en_US.UTF-8 PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      cd "$HOME" || exit
      exec zsh -fc 'source .zsh/plugins/defaults/defaults.plugin.zsh &amp;&amp; defaults dump' >/dev/null 2>>"$HOME/Library/Logs/defaults-dump.log"
    </string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>12</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
