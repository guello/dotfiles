{
  "rules": {
    "body-leading-blank": [
      2,
      "always"
    ],
    "scope-case": [
      2,
      "always",
      "lower-case"
    ],
    "scope-enum": [
      2,
      "always",
      [
        "claude",
        "codex",
        "copilot",
        "opencode",
        "pi",
        "cask",
        "mas",
        "vim",
        "nvim",
        "vscode",
        "zed",
        "gh",
        "glab",
        "ghostty",
        "defaults",
        "launchd",
        "npm",
        "plugin",
        "theme"
      ]
    ],
    "subject-empty": [
      2,
      "never"
    ],
    "subject-full-stop": [
      2,
      "never",
      "."
    ],
    "type-case": [
      2,
      "always",
      "lower-case"
    ],
    "type-empty": [
      2,
      "never"
    ],
    "type-enum": [
      2,
      "always",
      [
        "agents",
        "brew",
        "chore",
        "editor",
        "git",
        "gui",
        "macos",
        "node",
        "python",
        "ruby",
        "shell",
        "zsh"
      ]
    ]
  }
}
