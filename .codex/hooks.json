{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent codex --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/route-request.sh",
            "timeout": 25
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/guard-committed-writing.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/guard-managed-files.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/guard-remote-execution.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/guard-committed-writing.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/format-edited-file.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/guard-context-budgets.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
